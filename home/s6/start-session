#!/bin/sh
# Start user s6 session: s6-svscan + s6-rc-init + default bundle
# Called from fish login (conf.d/s6.fish)
set -eu

uid=$(id -u)
runtime="/run/user/${uid}"
scandir="${runtime}/s6-scandir"
rcdb="${HOME}/.local/share/s6/rc/compiled"
live="${runtime}/s6-rc"

# Already initialized? Nothing to do
if [ -d "$live" ] && s6-rc -l "$live" listallsv 2>/dev/null | grep -q .; then
    exit 0
fi

# Wait for elogind runtime dir
while [ ! -d "$runtime" ]; do
    sleep 1
done

export XDG_RUNTIME_DIR="$runtime"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${runtime}/bus"

# Create scan dir and start s6-svscan if not running
mkdir -p "$scandir"
if ! pgrep -u "$uid" -x s6-svscan >/dev/null 2>&1; then
    s6-svscan "$scandir" &
    disown
    sleep 1
fi

# Initialize s6-rc and bring up default bundle
if [ ! -d "$live" ]; then
    s6-rc-init -c "$rcdb" -l "$live" "$scandir"
fi

s6-rc -l "$live" -up change default
